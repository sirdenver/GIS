    {
      "type" : "CIMBinaryReference",
      "uRI" : "CIMPATH=Metadata/72e88ff74baff22f6d7c511b9632b33d.xml",
      "data" : "<?xml version=\"1.0\"?>\r\n<metadata xml:lang=\"en\"><Esri><CreaDate>20260724</CreaDate><CreaTime>20223500</CreaTime><ArcGISFormat>1.0</ArcGISFormat><SyncOnce>TRUE</SyncOnce></Esri><dataIdInfo><idCitation><resTitle>County Wildfire Burn Percentage Layer.</resTitle></idCitation><idPurp>This dataset shows the percentage of county area burned by wildfires in California</idPurp><idAbs>&lt;DIV STYLE=\"text-align:Left;font-size:12pt\"&gt;&lt;DIV&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;This layer was created by joining the output of the Summary Statistics tool (wildfire area burned) to the County boundaries layer. A new field was added to calculate the percentage of area burned ((!Wildfire_Area!/&lt;/SPAN&gt;&lt;SPAN&gt;!&lt;/SPAN&gt;&lt;SPAN&gt;Area_Acres!)*100). The data was symbolized using Natural Breaks into five classes. A basemap was added for reference, and counties were labeled with their names.&lt;/SPAN&gt;&lt;SPAN&gt;  The sources of data were CAL FIRE, US Census Bureau TIGER/Line shapefiles and Basemaps were obtained from Esri&lt;/SPAN&gt;&lt;/P&gt;&lt;P&gt;&lt;SPAN&gt;Date of Processing: July 24, 2026&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;&lt;/DIV&gt;</idAbs><idCredit>Denver Chikwehwa</idCredit><searchKeys><keyword>Wildfire</keyword><keyword>California</keyword><keyword>burn percentage</keyword><keyword>counties</keyword><keyword>GIS</keyword><keyword>ArcGIS Pro</keyword></searchKeys><resConst><Consts><useLimit>&lt;DIV STYLE=\"text-align:Left;font-size:12pt\"&gt;&lt;P&gt;&lt;SPAN&gt;For educational use only. Not for operational fire management decisions&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;</useLimit></Consts></resConst></dataIdInfo></metadata>\r\n"
    },
